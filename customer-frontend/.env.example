# StayEase frontend environment configuration
# Copy to `.env` and adjust values as needed.

# Base URL for the backend API when the real backend is connected.
# Leave unset (or empty) to run the app entirely on the built-in mock service layer.
VITE_API_BASE_URL=

# Service backend selector: "mock" (default, no backend needed) or "http".
# In "mock" mode all data is served from a localStorage-backed demo store.
# In "http" mode the API client talks to VITE_API_BASE_URL instead.
VITE_SERVICE_MODE=mock

# When "http" mode is active and the backend is unreachable, requests will fail
# with a descriptive error. There is intentionally no silent fallback so the
# integration team never mistakes mock data for live data.