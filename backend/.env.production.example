# ============================================================================
# Hotel Management System — Production Environment Configuration Template
# Copy this file to .env.production on your production server and fill in secrets.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Frontend Origin for Strict CORS Whitelisting
FRONTEND_URL=https://hotel.yourdomain.com

# Cryptographic QR Token Salt
QR_SECRET_SALT=replace-with-a-cryptographically-secure-random-string-in-production

# Supabase Production PostgreSQL & API Credentials
# Retrieve from: Supabase Dashboard -> Settings -> API & Database
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payment Gateway: Visa / Stripe (Production)
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_endpoint_secret

# Payment Gateway: KBZPay (Production)
KBZPAY_APP_ID=kp_replace_with_kbzpay_app_id
KBZPAY_MERCH_CODE=200_replace_with_kbzpay_merchant_code
KBZPAY_MERCHANT_KEY=replace_with_kbzpay_production_merchant_secret_key

# Tiered Rate Limiting Configurations (Optional overrides)
GLOBAL_RATE_LIMIT=100
STRICT_RATE_LIMIT=10
